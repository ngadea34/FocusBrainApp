# Copie ce fichier en .env (jamais commité) puis remplis les valeurs.

# Supabase > ton projet > Connect > « Session pooler » (port 5432). Remplace [YOUR-PASSWORD]
# par le mot de passe de la base (Project Settings > Database).
DATABASE_URL=postgresql://postgres.nejqievnldeqiasqsdlj:[YOUR-PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://nejqievnldeqiasqsdlj.supabase.co
